#!/usr/bin/env bash
set -euo pipefail

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly SOURCE="$SCRIPT_DIR/smk25-pad-layers.c"
readonly CONFIG_SOURCE="$SCRIPT_DIR/smk25-pad-layers.conf"
readonly SERVICE_SOURCE="$SCRIPT_DIR/smk25-pad-layers.service"
readonly BINARY="$HOME/.local/bin/smk25-pad-layers"
readonly CONFIG="$HOME/.config/smk25-pad-layers.conf"
readonly SERVICE="$HOME/.config/systemd/user/smk25-pad-layers.service"
readonly STATE_DIR="$HOME/.local/state/smk25-pad-layers"

mkdir -p \
  "$(dirname -- "$BINARY")" \
  "$(dirname -- "$CONFIG")" \
  "$(dirname -- "$SERVICE")" \
  "$STATE_DIR"

temporary="$(mktemp "${BINARY}.tmp.XXXXXX")"
trap 'rm -f "$temporary"' EXIT

gcc -std=c11 -O2 -Wall -Wextra -Werror \
  "$SOURCE" -Wl,-l:libjack.so.0 -o "$temporary"
"$temporary" --self-test
"$temporary" --check-config "$CONFIG_SOURCE"
chmod 0755 "$temporary"
mv -f "$temporary" "$BINARY"
cp "$CONFIG_SOURCE" "$CONFIG"
cp "$SERVICE_SOURCE" "$SERVICE"

systemctl --user daemon-reload
systemctl --user enable smk25-pad-layers.service
systemctl --user restart smk25-pad-layers.service
