#!/usr/bin/env bash
set -euo pipefail

readonly DURATION=${1:?duration is required}
readonly MIDI_PORTS=${2:?MIDI port is required}

if [[ ! $DURATION =~ ^[1-9][0-9]*$ || $DURATION -gt 900 ]]; then
    printf 'Duration must be an integer from 1 to 900 seconds.\n' >&2
    exit 2
fi
if [[ ! $MIDI_PORTS =~ ^[0-9]+:[0-9]+(,[0-9]+:[0-9]+)*$ ]]; then
    printf 'MIDI ports must use client:port[,client:port...] syntax.\n' >&2
    exit 2
fi

for command in aseqdump date journalctl jq mktemp pw-link pw-top sha256sum stdbuf timeout wc; do
    command -v "$command" >/dev/null 2>&1 || {
        printf 'Required observation command not found: %s\n' "$command" >&2
        exit 2
    }
done

readonly started_epoch=$(date +%s)
readonly started_at=$(date -u -d "@$started_epoch" +%Y-%m-%dT%H:%M:%SZ)
readonly temporary=$(mktemp -d "${TMPDIR:-/tmp}/music-rig-control-xrun.XXXXXX")

cleanup() {
    rm -rf "$temporary"
}
trap cleanup EXIT

link_hash_before=$(pw-link -l | sha256sum)
link_hash_before=${link_hash_before%% *}
journalctl --user --since "@$started_epoch" --grep='xrun|dropout|deadline' --no-pager -q \
    > "$temporary/journal-before.txt" 2>/dev/null || true

(
    timeout --signal=INT --kill-after=2s "${DURATION}s" \
        stdbuf -oL aseqdump -p "$MIDI_PORTS" 2>&1 |
        while IFS= read -r line; do
            case "$line" in
                *'Note on '*|*'Note off '*|*'Control change '*)
                    printf '%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%S.%NZ)" "$line"
                    ;;
            esac
        done
    pipeline_status=${PIPESTATUS[0]}
    exit "$pipeline_status"
) > "$temporary/midi.tsv" 2>&1 &
midi_pid=$!

pw-top -b -n "$((DURATION + 1))" > "$temporary/pw-top.txt" 2>&1 &
pw_top_pid=$!

set +e
wait "$midi_pid"
midi_status=$?
wait "$pw_top_pid"
pw_top_status=$?
set -e

readonly ended_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
readonly ended_epoch=$(date +%s)
link_hash_after=$(pw-link -l | sha256sum)
link_hash_after=${link_hash_after%% *}
journalctl --user --since "@$started_epoch" --until "@$ended_epoch" \
    --grep='xrun|dropout|deadline' --no-pager -q \
    > "$temporary/journal-after.txt" 2>/dev/null || true

midi_summary=$(jq -Rn --argjson started_epoch "$started_epoch" '
    def control_payload:
        (capture("Control change\\s+(?<channel>[0-9]+),\\s+controller\\s+(?<controller>[0-9]+),\\s+value\\s+(?<value>[0-9]+)\\s*$") // null)
        | if . == null then null else
            map_values(tonumber)
            | if .channel < 16 and .controller < 128 and .value < 128 then . else null end
          end;
    def control_summary:
        map(select(.event == "Control change" and .control != null))
        | group_by([.source, .control.channel, .control.controller])
        | map({
            source: .[0].source,
            channel: .[0].control.channel,
            controller: .[0].control.controller,
            count: length,
            value_first: .[0].control.value,
            value_last: .[-1].control.value,
            value_min: (map(.control.value) | min),
            value_max: (map(.control.value) | max)
        });
    [
        inputs
        | split("\t")
        | select(length == 2)
        | {timestamp: .[0], raw: .[1]}
        | . as $event
        | ($event.raw
            | capture("^\\s*(?<source>[0-9]+:[0-9]+)\\s+(?<event>Note on|Note off|Control change)")) as $match
        | $event + {source: $match.source, event: $match.event}
        | .control = (if .event == "Control change" then .raw | control_payload else null end)
    ]
    | {
        event_count: length,
        first_arrival: (.[0].timestamp // null),
        last_arrival: (.[-1].timestamp // null),
        control_changes: control_summary,
        unparsed_control_change_count: (
            map(select(.event == "Control change" and .control == null)) | length
        ),
        arrival_buckets: (
            group_by(.timestamp[0:19])
             | map({
                 timestamp: (.[0].timestamp[0:19] + "Z"),
                 second: ((.[0].timestamp[0:19] + "Z" | fromdateiso8601) - $started_epoch),
                 count: length,
                 control_changes: control_summary,
                 unparsed_control_change_count: (
                     map(select(.event == "Control change" and .control == null)) | length
                 ),
                event_types: (
                    group_by(.event)
                    | map({event: .[0].event, count: length})
                ),
                sources: (
                    group_by(.source)
                    | map({source: .[0].source, count: length})
                )
            })
        ),
        event_types: (
            group_by(.event)
            | map({event: .[0].event, count: length})
        ),
        sources: (
            group_by(.source)
            | map({source: .[0].source, count: length})
        )
    }
' < "$temporary/midi.tsv")

pipewire_samples=$(jq -Rn '
    def duration_us:
        (capture("^(?<value>[0-9]+(?:\\.[0-9]+)?)(?<unit>ns|us|ms|s)$") // null) as $duration
        | if $duration == null then null else
            ($duration.value | tonumber) *
            ({ns: 0.001, us: 1, ms: 1000, s: 1000000}[$duration.unit])
          end;
    reduce inputs as $line (
        {sample: 0, rows: []};
        if ($line | test("^S\\s+ID\\s+QUANT")) then
            .sample += 1
        elif ($line | startswith("R ")) then
            ($line | capture(
                "^R\\s+(?<id>[0-9]+)\\s+(?<quantum>[0-9]+)\\s+(?<rate>[0-9]+)\\s+(?<wait>\\S+)\\s+(?<busy>\\S+)\\s+(?<wait_ratio>\\S+)\\s+(?<busy_ratio>\\S+)\\s+(?<err>[0-9]+)\\s+(?<name>.*)$"
            ) // null) as $match
            | if $match == null then
                  .
              else
                  .rows += [{
                      sample: .sample,
                      id: ($match.id | tonumber),
                      err: ($match.err | tonumber),
                      name: $match.name,
                      timing: {
                          quantum_frames: ($match.quantum | tonumber),
                          rate_hz: ($match.rate | tonumber),
                          wait_raw: $match.wait,
                          busy_raw: $match.busy,
                          wait_us: ($match.wait | duration_us),
                          busy_us: ($match.busy | duration_us),
                          wait_quantum_ratio_raw: $match.wait_ratio,
                          busy_quantum_ratio_raw: $match.busy_ratio,
                          wait_quantum_ratio: ($match.wait_ratio | tonumber? // null),
                          busy_quantum_ratio: ($match.busy_ratio | tonumber? // null)
                      }
                  }]
              end
        else
            .
        end
    )
    | .rows
    | group_by(.sample)
    | map({
        second: (.[0].sample - 1),
        nodes: map({id, name, err, timing})
    })
    | reduce .[] as $sample (
        {previous: {}, output: []};
        . as $state
        | ($sample.nodes | map(
            . as $node
            | $node + {
                err_delta: (
                    $node.err -
                    ($state.previous[($node.id | tostring)] // $node.err)
                )
            }
        )) as $nodes
        | .output += [{second: $sample.second, nodes: $nodes}]
        | .previous += (
            $nodes
            | map({key: (.id | tostring), value: .err})
            | from_entries
        )
    )
    | .output
' < "$temporary/pw-top.txt")

printf '%s\n' "$pipewire_samples" > "$temporary/pw-samples.json"

pipewire_summary=$(jq '
    [.[] | .nodes[]]
    | group_by(.id)
    | . as $groups
    | map({
        id: .[0].id,
        name: .[0].name,
        samples: length,
        err_before: .[0].err,
        err_after: .[-1].err,
        err_delta: (.[-1].err - .[0].err)
    })
    | {
        samples: (map(.samples) | max // 0),
        total_err_delta: (map(.err_delta) | add // 0),
        changed_nodes: map(select(.err_delta != 0)),
        timing_nodes: ($groups | map({
            id: .[0].id,
            name: .[0].name,
            samples: length,
            wait_samples: (map(.timing.wait_us | select(. != null)) | length),
            busy_samples: (map(.timing.busy_us | select(. != null)) | length),
            wait_us_max: (map(.timing.wait_us) | max),
            busy_us_max: (map(.timing.busy_us) | max),
            wait_quantum_ratio_max: (map(.timing.wait_quantum_ratio) | max),
            busy_quantum_ratio_max: (map(.timing.busy_quantum_ratio) | max)
        }))
    }
' "$temporary/pw-samples.json")

printf '%s\n' "$midi_summary" > "$temporary/midi-summary.json"
printf '%s\n' "$pipewire_summary" > "$temporary/pipewire-summary.json"

journal_before_lines=$(wc -l < "$temporary/journal-before.txt")
journal_after_lines=$(wc -l < "$temporary/journal-after.txt")

jq -nS \
    --arg schema 'music-studies/airstar-control-xrun-correlation/v1' \
    --arg started_at "$started_at" \
    --arg ended_at "$ended_at" \
    --argjson duration "$DURATION" \
    --arg midi_ports "$MIDI_PORTS" \
    --arg link_hash_before "$link_hash_before" \
    --arg link_hash_after "$link_hash_after" \
    --slurpfile midi "$temporary/midi-summary.json" \
    --slurpfile pipewire "$temporary/pipewire-summary.json" \
    --slurpfile pw_samples "$temporary/pw-samples.json" \
    --argjson journal_before "$journal_before_lines" \
    --argjson journal_after "$journal_after_lines" \
    --argjson midi_status "$midi_status" \
    --argjson pw_top_status "$pw_top_status" '
    {
        schema: $schema,
        safety: {
            mode: "read-only",
            mutates_graph: false,
            controls_services: false,
            changes_parameters: false,
            remote_files: "temporary-only"
        },
        captured_at_utc: {start: $started_at, end: $ended_at},
        duration_seconds: $duration,
        midi_ports: $midi_ports,
        midi: $midi[0],
        pipewire: {
            pw_top: $pipewire[0],
            samples_by_second: $pw_samples[0],
            journal_xrun_dropout_deadline_lines: {
                before: $journal_before,
                during_and_after: $journal_after
            }
        },
        protected_graph: {
            link_hash_before: $link_hash_before,
            link_hash_after: $link_hash_after,
            unchanged: ($link_hash_before == $link_hash_after)
        },
        correlation: {
            per_second: [
                range(0; (
                    [$duration] + ($midi[0].arrival_buckets | map(.second)) +
                    ($pw_samples[0] | map(.second)) | max
                ) + 1) as $second
                | {
                    second: $second,
                    midi: (
                        [$midi[0].arrival_buckets[] |
                            select(.second == $second)]
                        | .[0] // {
                            second: $second,
                            count: 0,
                            control_changes: [],
                            unparsed_control_change_count: 0,
                            event_types: [],
                            sources: []
                        }
                    ),
                    pipewire: (
                        [$pw_samples[0][] |
                            select(.second == $second)]
                        | .[0] // {second: $second, nodes: []}
                    )
                }
            ]
        },
        command_status: {
            aseqdump_timeout_status: $midi_status,
            pw_top_status: $pw_top_status,
            temporary_cleanup: true
        },
        notes: [
            "MIDI timestamps are observer arrival times grouped into UTC-second buckets, not device-event timestamps.",
            "Control-change groups preserve ALSA source, zero-based MIDI channel, controller number, arrival count, and first/last/minimum/maximum values; mirrored ports remain separate.",
            "PipeWire seconds are nominal snapshot indices; deltas cover the interval since each node was last sampled. The final boundary sample is retained.",
            "PipeWire timing contains sampled pw-top WAIT/BUSY and W/Q/B/Q fields, not per-cycle maxima. Unknown markers remain in raw fields with null numeric values; zero follower quantum/rate values are preserved.",
            "pw-top ERR is the PipeWire cumulative xrun/error counter; changed nodes require attribution review.",
            "This observer never creates or removes links and does not control services, Carla, EQ parameters, or quantum."
        ]
    }
'
