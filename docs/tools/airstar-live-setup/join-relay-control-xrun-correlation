#!/usr/bin/env bash
set -euo pipefail

usage() {
    printf '%s\n' \
        "Usage: $(basename "$0") OBSERVER_JSON RELAY_LOG OUTPUT_JSON" \
        "Join the read-only observer with the stopped relay's per-second trace."
}

if [[ ${1-} == --help || ${1-} == -h ]]; then
    usage
    exit 0
fi
if [[ $# != 3 ]]; then
    usage >&2
    exit 2
fi

observer_json=$1
relay_log=$2
output_json=$3

for path in "$observer_json" "$relay_log"; do
    [[ -f $path ]] || {
        printf 'Input file not found: %s\n' "$path" >&2
        exit 2
    }
    [[ ! $output_json -ef $path ]] || {
        printf 'Output must not overwrite an input file: %s\n' "$path" >&2
        exit 2
    }
done
[[ -d $(dirname -- "$output_json") ]] || {
    printf 'Output directory does not exist: %s\n' "$(dirname -- "$output_json")" >&2
    exit 2
}
command -v jq >/dev/null 2>&1 || {
    printf '%s\n' 'Required command not found: jq' >&2
    exit 2
}

joined=$(jq -RnS --slurpfile observer "$observer_json" '
    reduce inputs as $line (
        {start_epoch: null, sample_rate: null, traces: []};
        if ($line | startswith("trace-start-epoch")) then
            if .start_epoch != null then error("Duplicate trace start epoch") else
                .start_epoch = (($line | capture("^trace-start-epoch (?<value>[0-9]+)$")
                    // error("Malformed trace start epoch")).value | tonumber)
            end
        elif ($line | startswith("trace-sample-rate")) then
            if .sample_rate != null then error("Duplicate trace sample rate") else
                .sample_rate = (($line | capture("^trace-sample-rate (?<value>[0-9]+)$")
                    // error("Malformed trace sample rate")).value | tonumber)
            end
        elif ($line | startswith("trace-second")) then
            .traces += [
                ($line | capture(
                    "^trace-second (?<second>[0-9]+) input-events (?<input>[0-9]+) mapped-events (?<mapped>[0-9]+) emitted-events (?<emitted>[0-9]+) coalesced-events (?<coalesced>[0-9]+) unmapped-events (?<unmapped>[0-9]+) malformed-events (?<malformed>[0-9]+) adapter-failures (?<failures>[0-9]+)$"
                ) // error("Malformed trace second")
                | {
                    second: (.second | tonumber),
                    input_events: (.input | tonumber),
                    mapped_events: (.mapped | tonumber),
                    emitted_events: (.emitted | tonumber),
                    coalesced_events: (.coalesced | tonumber),
                    unmapped_events: (.unmapped | tonumber),
                    malformed_events: (.malformed | tonumber),
                    adapter_failures: (.failures | tonumber)
                })
            ]
        else
            .
        end
    )
    | if .start_epoch == null or .start_epoch <= 0 or
         .sample_rate == null or .sample_rate <= 0 or
         (.traces | length) == 0 then
          error("Relay log requires a positive start epoch, sample rate, and trace seconds")
      elif (.traces | map(.second) | unique | length) != (.traces | length) then
          error("Duplicate relay trace second")
      else . end
    | . as $relay
    | if ($observer | length) != 1 or
         $observer[0].schema != "music-studies/airstar-control-xrun-correlation/v1" or
         ($observer[0].correlation.per_second | type) != "array" or
         ($observer[0].correlation.per_second | length) == 0 then
          error("Expected one control/xrun observer report with per-second correlation")
      else . end
    | $observer[0] as $observer
    | if all($observer.correlation.per_second[];
          (.second | type) == "number" and .second >= 0 and
          .second == (.second | floor) and (.pipewire.nodes | type) == "array" and
          all(.pipewire.nodes[]; (.err_delta | type) == "number")) and
          ($observer.correlation.per_second | map(.second) | unique | length) ==
          ($observer.correlation.per_second | length) then .
      else error("Invalid or duplicate observer second") end
    | ($observer.captured_at_utc.start | fromdateiso8601) as $observer_start
    | {
        schema: "music-studies/airstar-relay-control-xrun-correlation/v1",
        observer_schema: $observer.schema,
        observation: ($observer | {
            captured_at_utc, duration_seconds, safety, protected_graph, command_status
        }),
        relay: {
            start_epoch: $relay.start_epoch,
            sample_rate: $relay.sample_rate,
            trace_seconds: ($relay.traces | length)
        },
        per_second: [
            $observer.correlation.per_second[]
            | . as $second
            | (($observer_start + $second.second) - $relay.start_epoch) as $relay_second
            | .pipewire_error_delta = (
                [$second.pipewire.nodes[]?.err_delta] | add // 0
            )
            | .relay = (
                [$relay.traces[] | select(.second == $relay_second)]
                | .[0] // null
            )
            | .relay_second = $relay_second
        ]
    }
    | .relay.matched_seconds = ([.per_second[] | select(.relay != null)] | length)
' < "$relay_log")

printf '%s\n' "$joined" > "$output_json"

printf 'Wrote %s\n' "$output_json"
