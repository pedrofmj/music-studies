#!/usr/bin/env bash
set -euo pipefail

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly REPO_ROOT="$(cd -- "${SCRIPT_DIR}/../../.." && pwd)"
readonly PROJECT_JSON="${REPO_ROOT}/src/audio-software/carla/projects/pedro-live-rack/project.json"
readonly MANIFEST="${SCRIPT_DIR}/setup.json"
readonly RAW_SNAPSHOT="${REPO_ROOT}/src/midi-setup/airstar-patchbay.json"
readonly MIDI_SNAPSHOT="${REPO_ROOT}/src/midi-setup/airstar-midi-patchbay.json"
readonly DEPLOYMENT_SNAPSHOT="${REPO_ROOT}/src/midi-setup/pedro-live-rack-patchbay.json"
readonly PROJECT="${REPO_ROOT}/src/audio-software/carla/projects/pedro-live-rack/pedro.uproject"

usage() {
    printf '%s\n' \
        "Usage: $(basename "$0") --update-protected-baseline [HOST] [PROJECT]" \
        "" \
        "Replace the versioned stable-rig project and graph after an intentional" \
        "change. This is not a diagnostic or experimental capture command."
}

if [[ ${1-} == --help || ${1-} == -h ]]; then
    usage
    exit 0
fi

if [[ ${1-} != --update-protected-baseline ]]; then
    usage >&2
    exit 2
fi
shift

host=${1:-pedro.ferreira@airstar}
remote_project=${2:-/c/music/carla/pedro.uproject}
temporary=$(mktemp -d)
remote_prefix="/tmp/pedro-live-rack-capture-$$"

cleanup() {
    rm -rf "$temporary"
    ssh "$host" "rm -f '${remote_prefix}-all.json' '${remote_prefix}-midi.json'"         >/dev/null 2>&1 || true
}
trap cleanup EXIT

for command in jq scp sha256sum ssh; do
    command -v "$command" >/dev/null 2>&1 || {
        printf 'Required command not found: %s\n' "$command" >&2
        exit 1
    }
done

printf 'Capture assumes Carla has been saved: %s:%s\n' "$host" "$remote_project"
scp -q "$host:$remote_project" "$temporary/pedro.uproject"
ssh "$host"     "~/bin/pipewire-patchbay-json export '${remote_prefix}-all.json' &&      ~/bin/pipewire-patchbay-json export --midi-only '${remote_prefix}-midi.json'"
scp -q "$host:${remote_prefix}-all.json" "$temporary/all.json"
scp -q "$host:${remote_prefix}-midi.json" "$temporary/midi.json"

python3 -c '
import sys
import xml.etree.ElementTree as ET
root = ET.parse(sys.argv[1]).getroot()
plugins = root.findall("Plugin")
connections = root.findall("ExternalPatchbay/Connection")
names = [item.findtext("Info/Name") or "" for item in plugins]
valid = len(plugins) == 49 and len(set(names)) == 49 and len(connections) == 111
raise SystemExit(0 if valid else 1)
' "$temporary/pedro.uproject" || {
    printf 'Captured project does not match the expected 49/111 structure.\n' >&2
    exit 1
}

jq -e '
    .schema == "https://music-studies.local/schemas/pipewire-patchbay/v1"
    and .scope == "all"
' "$temporary/all.json" >/dev/null
jq -e '
    .schema == "https://music-studies.local/schemas/pipewire-patchbay/v1"
    and .scope == "midi-only"
' "$temporary/midi.json" >/dev/null

jq '
    .links |= map(
        select((.output.alias // "") | startswith("ALSA Playback [java]:") | not)
    )
    | .scope = "pedro-live-rack"
' "$temporary/all.json" > "$temporary/deployment.json"

install -m 0644 "$temporary/pedro.uproject" "$PROJECT"
install -m 0644 "$temporary/all.json" "$RAW_SNAPSHOT"
install -m 0644 "$temporary/midi.json" "$MIDI_SNAPSHOT"
install -m 0644 "$temporary/deployment.json" "$DEPLOYMENT_SNAPSHOT"

project_hash=$(sha256sum "$PROJECT")
project_hash=${project_hash%% *}
project_size=$(stat -c '%s' "$PROJECT")
captured_at=$(jq -r '.generated_at' "$RAW_SNAPSHOT")
raw_hash=$(sha256sum "$RAW_SNAPSHOT")
raw_hash=${raw_hash%% *}
midi_hash=$(sha256sum "$MIDI_SNAPSHOT")
midi_hash=${midi_hash%% *}
deployment_hash=$(sha256sum "$DEPLOYMENT_SNAPSHOT")
deployment_hash=${deployment_hash%% *}
raw_links=$(jq '.links | length' "$RAW_SNAPSHOT")
midi_links=$(jq '.links | length' "$MIDI_SNAPSHOT")
deployment_links=$(jq '.links | length' "$DEPLOYMENT_SNAPSHOT")

jq     --arg captured_at "$captured_at"     --arg sha256 "$project_hash"     --argjson size "$project_size"     '
    .captured_at = $captured_at
    | .sha256 = $sha256
    | .size_bytes = $size
    ' "$PROJECT_JSON" > "$temporary/project.json"
install -m 0644 "$temporary/project.json" "$PROJECT_JSON"

jq     --arg captured_at "$captured_at"     --arg project_hash "$project_hash"     --arg raw_hash "$raw_hash"     --arg midi_hash "$midi_hash"     --arg deployment_hash "$deployment_hash"     --argjson project_size "$project_size"     --argjson raw_links "$raw_links"     --argjson midi_links "$midi_links"     --argjson deployment_links "$deployment_links"     '
    .captured_at = $captured_at
    | .carla.project_sha256 = $project_hash
    | .carla.project_size_bytes = $project_size
    | .patchbay.raw_sha256 = $raw_hash
    | .patchbay.raw_links = $raw_links
    | .patchbay.midi_sha256 = $midi_hash
    | .patchbay.midi_links = $midi_links
    | .patchbay.deployment_sha256 = $deployment_hash
    | .patchbay.deployment_links = $deployment_links
    ' "$MANIFEST" > "$temporary/setup.json"
install -m 0644 "$temporary/setup.json" "$MANIFEST"

printf 'Captured project and graph from %s.\n' "$host"
printf 'Project: %s\nRaw links: %s; MIDI links: %s; deployment links: %s\n'     "$project_hash" "$raw_links" "$midi_links" "$deployment_links"
