def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Validate switch-benchmark contracts and result documents."
    )
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument(
        "--check-contract",
        action="store_true",
        help="validate the checked-in benchmark contract",
    )
    group.add_argument(
        "--validate",
        type=Path,
        metavar="PATH",
        help="validate one result document against the contract",
    )
    group.add_argument(
        "--self-test",
        action="store_true",
        help="run positive and negative semantic-validator tests",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    try:
        contract = load_json(CONTRACT_PATH)
        validate_contract(contract)
        if args.validate is not None:
            validate_result(load_json(args.validate), contract)
            print(f"Switch benchmark result: OK ({args.validate})")
        elif args.self_test:
            run_self_test(contract)
            print("Switch benchmark validator self-test: OK (13 negative cases)")
        else:
            print("Switch benchmark contract: OK")
    except ValidationError as error:
        print(f"Switch benchmark validation failed: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
