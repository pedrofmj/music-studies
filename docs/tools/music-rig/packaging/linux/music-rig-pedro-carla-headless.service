[Unit]
Description=Pedro full live rack headless Carla backend
After=pipewire.service wireplumber.service pipewire-patchbay-watch.service
Requires=pipewire.service

[Service]
Type=simple
Environment=LANG=C
Environment=LC_ALL=C
Environment=LC_NUMERIC=C
ExecStart=%h/.local/bin/carla-pedro-headless
Restart=on-failure
RestartSec=2s
KillMode=mixed
TimeoutStopSec=15s
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
