{
  "schema": "music-studies/performance-rig/v1",
  "kind": "rig-profile",
  "id": "fixture-live",
  "display_name": "Fixture Live",
  "device_profiles": {
    "fixture-controller": "fixture-role"
  },
  "readiness": "control-only",
  "takeover_policy": {
    "default": "ignore-until-moved",
    "volume": "pickup"
  },
  "state_policy": "persist",
  "required_capabilities": [
    "midi.performance-input",
    "parameter.master.volume"
  ],
  "ownership": [
    {
      "kind": "route",
      "target": "route.main-output",
      "mode": "exclusive"
    },
    {
      "kind": "route",
      "target": "route.main-output",
      "mode": "read-only"
    }
  ],
  "preparation": {
    "pinned_capabilities": [
      "engine.fixture"
    ]
  },
  "switch_safety": {
    "on_failure": "retain-active",
    "rollback": "required",
    "transition": "preserve"
  }
}
