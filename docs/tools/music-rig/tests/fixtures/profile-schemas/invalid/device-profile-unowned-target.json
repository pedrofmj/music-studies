{
  "schema": "music-studies/performance-rig/v1",
  "kind": "device-profile",
  "id": "fixture-role",
  "display_name": "Fixture Role With Unowned Target",
  "slot": "fixture-controller",
  "compatible_models": [
    "Fixture Controller Model"
  ],
  "hardware_preset": "fixture-preset",
  "required_endpoints": [
    "midi.performance-input"
  ],
  "required_capabilities": [
    "parameter.master.volume"
  ],
  "readiness": "control-only",
  "takeover_policy": {
    "default": "ignore-until-moved",
    "volume": "pickup"
  },
  "state_policy": "persist",
  "mappings": [
    {
      "id": "master-fader",
      "source_control": "fader-1",
      "target": "master.volume",
      "transform": {
        "type": "direct"
      }
    }
  ],
  "ownership": [
    {
      "kind": "parameter",
      "target": "master.pan",
      "mode": "exclusive"
    }
  ],
  "dependencies": {
    "engines": [
      "engine.fixture"
    ],
    "effects": [],
    "routes": [],
    "helpers": [],
    "assets": []
  },
  "switch_safety": {
    "on_failure": "retain-active",
    "rollback": "required",
    "transition": "preserve"
  }
}
