#!/usr/bin/env python3
"""Exercise the deterministic Performance Rig compilation envelope."""

from __future__ import annotations

import hashlib
import importlib.util
import json
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path
from types import ModuleType
from typing import Any, Optional, Sequence


sys.dont_write_bytecode = True


SCRIPT_PATH = Path(__file__).resolve()
TOOLS_ROOT = SCRIPT_PATH.parents[1]
REPOSITORY_ROOT = SCRIPT_PATH.parents[4]
COMPILER_PATH = TOOLS_ROOT / "compile-performance-rig.py"
RIG_ROOT = (
    REPOSITORY_ROOT / "src" / "performance-rigs" / "pedro-performance-rig"
)
GOLDEN_PATH = (
    TOOLS_ROOT / "tests" / "fixtures" / "compiled-current-envelope.json"
)
FINGERPRINT_PATTERN = re.compile(r"^sha256:[0-9a-f]{64}$")


def canonical_json_bytes(document: Any) -> bytes:
    return json.dumps(
        document,
        ensure_ascii=True,
        separators=(",", ":"),
        sort_keys=True,
    ).encode("utf-8")


def fingerprint(document: Any) -> str:
    return "sha256:" + hashlib.sha256(canonical_json_bytes(document)).hexdigest()


def load_compiler_module() -> ModuleType:
    spec = importlib.util.spec_from_file_location(
        "music_rig_authoring_compiler",
        COMPILER_PATH,
    )
    if spec is None or spec.loader is None:
        raise AssertionError("could not load compiler module")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def run_compiler(
    rig_root: Path,
    binding_id: str,
    cwd: Path,
    output: Optional[Path] = None,
    rig_profile: Optional[str] = None,
) -> subprocess.CompletedProcess:
    command = [
        sys.executable,
        str(COMPILER_PATH),
        "--rig-root",
        str(rig_root),
        "--platform-binding",
        binding_id,
    ]
    if rig_profile is not None:
        command.extend(["--rig-profile", rig_profile])
    if output is None:
        command.append("--check-only")
    else:
        command.extend(["--output", str(output)])
    return subprocess.run(
        command,
        cwd=str(cwd),
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )


def require_success(
    result: subprocess.CompletedProcess,
    label: str,
) -> None:
    if result.returncode != 0:
        raise AssertionError(
            f"{label} failed ({result.returncode}): {result.stderr}"
        )


def load_json(path: Path) -> Any:
    with path.open("r", encoding="utf-8") as handle:
        return json.load(handle)


def write_json(path: Path, document: Any) -> None:
    path.write_text(
        json.dumps(document, ensure_ascii=True, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )


def pycache_files() -> Sequence[str]:
    pycache = TOOLS_ROOT / "__pycache__"
    if not pycache.exists():
        return []
    return sorted(path.name for path in pycache.iterdir())


def add_alternate_binding(rig_root: Path) -> None:
    rig_path = rig_root / "rig.json"
    rig = load_json(rig_path)
    rig["platform_bindings"].append("airstar-alternate")
    write_json(rig_path, rig)

    source_path = (
        rig_root
        / "platform-bindings"
        / "linux"
        / "airstar-current.json"
    )
    binding = load_json(source_path)
    binding["id"] = "airstar-alternate"
    binding["display_name"] = "Airstar Alternate Test Binding"
    binding["description"] = "Synthetic deterministic compiler test binding."
    binding["device_slots"]["arturia-main"]["identity"][
        "value"
    ] = "fixture-alternate-arturia"
    alternate_path = source_path.with_name("airstar-alternate.json")
    write_json(alternate_path, binding)


def remove_required_binding_target(rig_root: Path) -> None:
    binding_path = (
        rig_root
        / "platform-bindings"
        / "linux"
        / "airstar-current.json"
    )
    binding = load_json(binding_path)
    for group in binding["binding_groups"]:
        group["targets"].pop("parameter.master-volume", None)
    write_json(binding_path, binding)


def break_relative_encoding(rig_root: Path) -> None:
    profile_path = (
        rig_root
        / "device-profiles"
        / "arturia-main"
        / "multi-instrument-rack.json"
    )
    profile = load_json(profile_path)
    for mapping in profile["mappings"]:
        if mapping["id"] == "master-volume":
            mapping["transform"]["relative_encoding"] = "twos-complement"
            break
    write_json(profile_path, profile)


def mapping_for(document: Any, key: str) -> Any:
    position = document["mapping_index"].get(key)
    if position is None:
        raise AssertionError(f"compiled mapping index omitted {key!r}")
    mapping = document["mappings"][position]
    if mapping["dispatch_key"] != key:
        raise AssertionError(f"compiled mapping index misdirected {key!r}")
    return mapping


def main() -> int:
    try:
        completed_cases = []
        compiler_module = load_compiler_module()
        with tempfile.TemporaryDirectory(
            prefix="music-rig-compiler-test-"
        ) as temporary:
            temporary_root = Path(temporary)
            first_output = temporary_root / "first.json"
            second_output = temporary_root / "second.json"
            other_cwd = temporary_root / "other-cwd"
            other_cwd.mkdir()

            first = run_compiler(
                RIG_ROOT,
                "airstar-current",
                REPOSITORY_ROOT,
                first_output,
            )
            require_success(first, "first compilation")
            second = run_compiler(
                RIG_ROOT,
                "airstar-current",
                other_cwd,
                second_output,
            )
            require_success(second, "second compilation")
            first_bytes = first_output.read_bytes()
            if first_bytes != second_output.read_bytes():
                raise AssertionError(
                    "compiled bytes differ across working directories"
                )
            completed_cases.append("repeatable-output")

            document = load_json(first_output)
            alternate_output = temporary_root / "alternate.json"
            alternate = run_compiler(
                RIG_ROOT,
                "airstar-current",
                REPOSITORY_ROOT,
                alternate_output,
                "multilevel-volume-mixed-pads",
            )
            require_success(alternate, "mixed profile compilation")
            alternate_document = load_json(alternate_output)
            if alternate_document["active_rig_profile"] != "multilevel-volume-mixed-pads":
                raise AssertionError("mixed profile was not selected")
            alternate_profiles = {
                (row["slot"], row["profile"])
                for row in alternate_document["device_profiles"]
            }
            if (
                ("smc-mixer-main", "multilevel-volume") not in alternate_profiles
                or ("smc-pad-main", "pad-layer-controller") not in alternate_profiles
                or ("smc-pad-pocket", "drum-set") not in alternate_profiles
            ):
                raise AssertionError("mixed profile device selection was not compiled")
            completed_cases.append("mixed-profile-selection")
            canonical_render = (
                json.dumps(
                    document,
                    ensure_ascii=True,
                    indent=2,
                    sort_keys=True,
                )
                + "\n"
            ).encode("utf-8")
            if first_bytes != canonical_render:
                raise AssertionError("compiled output is not canonical JSON")
            definition_fingerprint = document.pop("definition_fingerprint")
            if definition_fingerprint != fingerprint(document):
                raise AssertionError("definition fingerprint is not reproducible")
            for value in document["fingerprints"].values():
                if value != "sha256" and not FINGERPRINT_PATTERN.fullmatch(value):
                    raise AssertionError(f"invalid fingerprint value: {value}")

            for category in ("schemas", "portable"):
                manifest = document["source_manifest"][category]
                for entry in manifest:
                    source_document = load_json(RIG_ROOT / entry["path"])
                    if entry["fingerprint"] != fingerprint(source_document):
                        raise AssertionError(
                            f"incorrect {category} source fingerprint: "
                            f"{entry['path']}"
                        )
                aggregate_name = (
                    "schema_set" if category == "schemas" else "portable_source"
                )
                if document["fingerprints"][aggregate_name] != fingerprint(manifest):
                    raise AssertionError(
                        f"incorrect {aggregate_name} aggregate fingerprint"
                    )

            binding_manifest = document["source_manifest"]["platform_binding"]
            binding_document = load_json(RIG_ROOT / binding_manifest["path"])
            expected_binding_fingerprint = fingerprint(binding_document)
            if binding_manifest["fingerprint"] != expected_binding_fingerprint:
                raise AssertionError("incorrect binding source fingerprint")
            if (
                document["fingerprints"]["platform_binding"]
                != expected_binding_fingerprint
            ):
                raise AssertionError("incorrect aggregate binding fingerprint")

            manifest_paths = [
                entry["path"]
                for category in ("schemas", "portable")
                for entry in document["source_manifest"][category]
            ]
            manifest_paths.append(
                document["source_manifest"]["platform_binding"]["path"]
            )
            if any("\\" in path or path.startswith("/") for path in manifest_paths):
                raise AssertionError("manifest contains a machine-specific path")
            completed_cases.append("fingerprint-hierarchy")

            expected_counts = {
                "input_bindings": 5,
                "mappings": 72,
                "mapping_index": 72,
                "target_bindings": 71,
                "ownership": 57,
            }
            for field, expected_count in expected_counts.items():
                if len(document[field]) != expected_count:
                    raise AssertionError(
                        f"compiled {field} count is {len(document[field])}, "
                        f"expected {expected_count}"
                    )
            if sorted(document["mapping_index"].values()) != list(range(72)):
                raise AssertionError("mapping index is not a complete row index")
            if [row["dispatch_key"] for row in document["mappings"]] != sorted(
                document["mapping_index"]
            ):
                raise AssertionError("mapping rows are not dispatch-key ordered")

            arturia_relative = mapping_for(
                document,
                "arturia-main|cc|1|114",
            )
            if (
                arturia_relative["target"] != "master.volume"
                or arturia_relative["transform"] != {
                    "type": "relative",
                    "relative_encoding": "binary-offset",
                }
                or arturia_relative["source"]["relative_encoding"]
                != "binary-offset"
            ):
                raise AssertionError("Arturia relative mapping was not resolved")
            arturia_reverb = mapping_for(
                document,
                "arturia-main|cc|1|74",
            )
            if arturia_reverb["takeover"] != "ignore-until-moved":
                raise AssertionError("default absolute takeover was not resolved")
            if (
                mapping_for(document, "smc-mixer-main|cc|1|40")["target"]
                != "equalizer.band-63-hz.gain"
            ):
                raise AssertionError("SMC-Mixer mapping was not resolved")
            pad_main = mapping_for(document, "smc-pad-main|note|10|36")
            pad_pocket = mapping_for(document, "smc-pad-pocket|note|10|36")
            if (
                pad_main["target"] != "drum-set.notes"
                or pad_pocket["target"] != "drum-set.notes"
                or pad_main["slot"] == pad_pocket["slot"]
            ):
                raise AssertionError("independent pad dispatch was not preserved")
            smk_toggle = mapping_for(document, "smk25-main|cc|1|40")
            if (
                smk_toggle["source"].get("off_value") != 0
                or smk_toggle["source"].get("on_value") != 127
            ):
                raise AssertionError("SMK-25 toggle values were not compiled")
            if set(document["input_bindings"]) != {
                "arturia-main",
                "smk25-main",
                "smc-mixer-main",
                "smc-pad-main",
                "smc-pad-pocket",
            }:
                raise AssertionError("compiled input bindings omit a stable slot")
            if document["target_bindings"]["parameter.master-volume"] != {
                "adapter": "linux.current-rack-controls",
                "status": "available",
                "locator": "arturia-main-volume-encoder.service:master-volume",
            }:
                raise AssertionError("selected target binding was not compiled")
            completed_cases.append("runtime-lookup-tables")

            shared_notes = document["ownership"].get(
                "semantic-control|drum-set.notes"
            )
            shared_engine = document["ownership"].get(
                "engine|engine.drum-set"
            )
            if (
                shared_notes is None
                or shared_notes["mode"] != "shared-event-destination"
                or len(shared_notes["owners"]) != 2
                or shared_engine is None
                or shared_engine["mode"] != "read-only"
                or len(shared_engine["owners"]) != 2
            ):
                raise AssertionError("compatible shared ownership was not merged")
            completed_cases.append("consolidated-ownership")

            graph_delta = document["graph_delta"]
            if (
                not graph_delta["empty"]
                or not graph_delta["control_only_eligible"]
                or graph_delta["applied"]
                or any(graph_delta["counts"].values())
                or any(graph_delta["operations"].values())
            ):
                raise AssertionError("current control-only graph delta is not empty")
            completed_cases.append("current-empty-graph-delta")

            if first_bytes != GOLDEN_PATH.read_bytes():
                raise AssertionError("compiled output differs from golden fixture")
            completed_cases.append("golden-output")

            pycache_before = pycache_files()
            check_only = run_compiler(
                RIG_ROOT,
                "airstar-current",
                other_cwd,
            )
            require_success(check_only, "check-only compilation")
            if pycache_files() != pycache_before:
                raise AssertionError("check-only compilation wrote bytecode")
            completed_cases.append("check-only-no-write")

            rig_path = RIG_ROOT / "rig.json"
            rig_before = rig_path.read_bytes()
            overwrite = run_compiler(
                RIG_ROOT,
                "airstar-current",
                other_cwd,
                rig_path,
            )
            if overwrite.returncode != 1 or "overwrite source" not in overwrite.stderr:
                raise AssertionError("compiler did not reject source overwrite")
            if rig_path.read_bytes() != rig_before:
                raise AssertionError("source-overwrite rejection changed rig.json")
            completed_cases.append("source-overwrite-rejection")

            missing = run_compiler(
                RIG_ROOT,
                "missing-binding",
                other_cwd,
            )
            if missing.returncode != 1 or missing.stderr != (
                "ERROR: unresolved Platform Binding 'missing-binding'\n"
            ):
                raise AssertionError("missing-binding diagnostic is unstable")
            completed_cases.append("missing-binding-diagnostic")

            alternate_root = temporary_root / "alternate-rig"
            shutil.copytree(RIG_ROOT, alternate_root)
            add_alternate_binding(alternate_root)
            current_output = temporary_root / "current-binding.json"
            alternate_output = temporary_root / "alternate-binding.json"
            require_success(
                run_compiler(
                    alternate_root,
                    "airstar-current",
                    other_cwd,
                    current_output,
                ),
                "current binding in multi-binding Rig",
            )
            require_success(
                run_compiler(
                    alternate_root,
                    "airstar-alternate",
                    other_cwd,
                    alternate_output,
                ),
                "alternate binding in multi-binding Rig",
            )
            current_document = load_json(current_output)
            alternate_document = load_json(alternate_output)
            if (
                current_document["fingerprints"]["portable_source"]
                != alternate_document["fingerprints"]["portable_source"]
            ):
                raise AssertionError(
                    "portable fingerprint changed with binding selection"
                )
            if (
                current_document["fingerprints"]["platform_binding"]
                == alternate_document["fingerprints"]["platform_binding"]
            ):
                raise AssertionError("binding fingerprints are not independent")
            if (
                current_document["definition_fingerprint"]
                == alternate_document["definition_fingerprint"]
            ):
                raise AssertionError("definition ignored binding selection")
            if current_document["mappings"] != alternate_document["mappings"]:
                raise AssertionError("portable mappings changed with binding")
            if (
                current_document["input_bindings"]
                == alternate_document["input_bindings"]
            ):
                raise AssertionError("compiled inputs ignored binding selection")
            completed_cases.append("independent-binding")

            diagnostic_outputs = []
            for root_name in ("invalid-one", "invalid-two"):
                invalid_root = temporary_root / root_name
                shutil.copytree(RIG_ROOT, invalid_root)
                remove_required_binding_target(invalid_root)
                invalid = run_compiler(
                    invalid_root,
                    "airstar-current",
                    other_cwd,
                )
                if invalid.returncode != 1:
                    raise AssertionError("invalid catalogue compiled")
                diagnostic_outputs.append(invalid.stderr)
            if diagnostic_outputs[0] != diagnostic_outputs[1]:
                raise AssertionError(
                    "catalogue diagnostics depend on absolute Rig path"
                )
            if "unresolved capabilities" not in diagnostic_outputs[0]:
                raise AssertionError("missing capability diagnostic was absent")

            completed_cases.append("relocatable-diagnostics")

            graph_resources = {
                "assets": set(),
                "effects": set(),
                "engines": set(),
                "helpers": set(),
                "routes": {"route.fixture-missing"},
            }
            prepared_delta = compiler_module.compile_graph_delta(
                "prepared-fixture",
                "prepared",
                graph_resources,
                {},
            )
            if (
                prepared_delta["empty"]
                or prepared_delta["control_only_eligible"]
                or prepared_delta["counts"]["created_links"] != 1
            ):
                raise AssertionError("nonempty prepared graph delta was misclassified")
            try:
                compiler_module.compile_graph_delta(
                    "control-only-fixture",
                    "control-only",
                    graph_resources,
                    {},
                )
            except compiler_module.CompilationError as error:
                if (
                    "control-only"
                    not in str(error)
                    or "nonempty graph delta" not in str(error)
                ):
                    raise AssertionError(
                        "control-only graph diagnostic is incomplete"
                    )
            else:
                raise AssertionError("control-only nonempty graph delta compiled")
            completed_cases.append("graph-delta-safety")

            mismatch_root = temporary_root / "relative-mismatch-rig"
            shutil.copytree(RIG_ROOT, mismatch_root)
            break_relative_encoding(mismatch_root)
            mismatch = run_compiler(
                mismatch_root,
                "airstar-current",
                other_cwd,
            )
            if (
                mismatch.returncode != 1
                or "relative encoding 'twos-complement' differs"
                not in mismatch.stderr
            ):
                raise AssertionError("relative encoding mismatch compiled")
            completed_cases.append("relative-encoding-rejection")

        if len(completed_cases) != 14:
            raise AssertionError(
                f"compiler test accounting expected 14, got {completed_cases}"
            )
        print("Performance Rig compiler tests: PASS (cases=14)")
        return 0
    except (AssertionError, OSError, ValueError, KeyError) as error:
        print(f"FAIL: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
