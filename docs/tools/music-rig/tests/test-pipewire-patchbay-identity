JSON

output=$(
    PATH="${FAKE_BIN}:$PATH" \
    MUSIC_RIG_FAKE_PW_DUMP="$CURRENT_GRAPH" \
        "$TOOL" import --names --dry-run "$SAVED_GRAPH" 2>&1
)
printf '%s\n' "$output"
grep -Fq -- 'Missing: 630 -> 50 (would connect)' <<<"$output"
grep -Fq -- 'Dry run: 1 total, 0 present, 1 would restore, 0 unresolved' \
    <<<"$output"
if grep -Fq -- 'Missing: 79 -> 50' <<<"$output"; then
    printf '%s\n' 'Resolver selected the stale exact SINCO selector.' >&2
    exit 1
fi

printf '%s\n' 'PipeWire patchbay identity test: OK'
