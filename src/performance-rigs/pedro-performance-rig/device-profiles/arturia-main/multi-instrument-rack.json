    },
    {
      "kind": "state-key",
      "target": "master.volume",
      "mode": "exclusive"
    },
    {
      "kind": "state-key",
      "target": "master.mute",
      "mode": "exclusive"
    }
  ],
  "dependencies": {
    "engines": [
      "engine.arturia.basic-piano",
      "engine.arturia.nord-white-grand",
      "engine.arturia.alt-strings",
      "engine.arturia.good-flute",
      "engine.arturia.sax-lirakeys",
      "engine.arturia.hammond-organ-fast",
      "engine.arturia.optik-synth",
      "engine.arturia.pad-efeitos",
      "engine.arturia.atmosfera-pad"
    ],
    "effects": [
      "effect.arturia.sustain-scale",
      "effect.arturia.channel-2-output-trim",
      "effect.master.instrument-mixer"
    ],
    "routes": [
      "route.arturia.performance-fanout",
      "route.arturia.controls",
      "route.master.output"
    ],
    "helpers": [
      "helper.arturia-main-volume-encoder"
    ],
    "assets": [
      "asset.arturia.basic-piano",
      "asset.arturia.nord-white-grand",
      "asset.arturia.alt-strings",
      "asset.arturia.good-flute",
      "asset.arturia.sax-lirakeys",
      "asset.arturia.hammond-organ-fast",
      "asset.arturia.optik-synth",
      "asset.arturia.pad-efeitos",
      "asset.arturia.atmosfera-pad"
    ]
  },
  "switch_safety": {
    "on_failure": "retain-active",
    "rollback": "required",
    "transition": "preserve"
  }
