{
  "schema": "music-studies/performance-rig/v1",
  "kind": "device-profile",
  "id": "tonewheel-organ-setbfree",
  "display_name": "Tonewheel Organ Layout (setBfree Candidate)",
  "description": "Candidate Arturia setBfree organ layout with nine drawbars and verified MIDI-native organ controls; not included in the protected Airstar binding.",
  "slot": "arturia-main",
  "compatible_models": ["KeyLab Essential 61 mk3"],
  "hardware_preset": "arturia-current-rack",
  "required_endpoints": ["midi.performance-input"],
  "required_capabilities": [
    "notes.layered-instruments",
    "parameter.layer-volume",
    "parameter.layer-reverb",
    "parameter.master-volume",
    "control.master-mute"
  ],
  "readiness": "control-only",
  "takeover_policy": {"default": "ignore-until-moved", "volume": "pickup"},
  "state_policy": "persist",
  "mappings": [
    {"id": "drawbar-16ft", "source_control": "fader-1", "target": "organ.drawbar.16ft", "transform": {"type": "direct"}, "takeover": "pickup"},
    {"id": "drawbar-5-1-3ft", "source_control": "fader-2", "target": "organ.drawbar.5-1-3ft", "transform": {"type": "direct"}, "takeover": "pickup"},
    {"id": "drawbar-8ft", "source_control": "fader-3", "target": "organ.drawbar.8ft", "transform": {"type": "direct"}, "takeover": "pickup"},
    {"id": "drawbar-4ft", "source_control": "fader-4", "target": "organ.drawbar.4ft", "transform": {"type": "direct"}, "takeover": "pickup"},
    {"id": "drawbar-2-2-3ft", "source_control": "fader-5", "target": "organ.drawbar.2-2-3ft", "transform": {"type": "direct"}, "takeover": "pickup"},
    {"id": "drawbar-2ft", "source_control": "fader-6", "target": "organ.drawbar.2ft", "transform": {"type": "direct"}, "takeover": "pickup"},
    {"id": "drawbar-1-3-5ft", "source_control": "fader-7", "target": "organ.drawbar.1-3-5ft", "transform": {"type": "direct"}, "takeover": "pickup"},
    {"id": "drawbar-1-1-3ft", "source_control": "fader-8", "target": "organ.drawbar.1-1-3ft", "transform": {"type": "direct"}, "takeover": "pickup"},
    {"id": "drawbar-1ft", "source_control": "fader-9", "target": "organ.drawbar.1ft", "transform": {"type": "direct"}, "takeover": "pickup"},
    {"id": "percussion", "source_control": "knob-1", "target": "organ.percussion", "transform": {"type": "direct"}},
    {"id": "key-click", "source_control": "knob-2", "target": "organ.key-click", "transform": {"type": "direct"}},
    {"id": "leakage", "source_control": "knob-3", "target": "organ.leakage", "transform": {"type": "direct"}},
    {"id": "chorus-vibrato", "source_control": "knob-4", "target": "organ.chorus-vibrato", "transform": {"type": "direct"}},
    {"id": "rotary-speed", "source_control": "knob-5", "target": "organ.rotary-speed", "transform": {"type": "direct"}},
    {"id": "drive", "source_control": "knob-6", "target": "organ.drive", "transform": {"type": "direct"}},
    {"id": "microphone-balance", "source_control": "knob-7", "target": "organ.microphone-balance", "transform": {"type": "direct"}},
    {"id": "organ-volume", "source_control": "knob-8", "target": "organ.volume", "transform": {"type": "direct"}},
    {"id": "organ-reverb", "source_control": "knob-9", "target": "organ.reverb", "transform": {"type": "direct"}}
  ],
  "ownership": [
    {"kind": "parameter", "target": "organ.drawbar.16ft", "mode": "exclusive"},
    {"kind": "parameter", "target": "organ.drawbar.5-1-3ft", "mode": "exclusive"},
    {"kind": "parameter", "target": "organ.drawbar.8ft", "mode": "exclusive"},
    {"kind": "parameter", "target": "organ.drawbar.4ft", "mode": "exclusive"},
    {"kind": "parameter", "target": "organ.drawbar.2-2-3ft", "mode": "exclusive"},
    {"kind": "parameter", "target": "organ.drawbar.2ft", "mode": "exclusive"},
    {"kind": "parameter", "target": "organ.drawbar.1-3-5ft", "mode": "exclusive"},
    {"kind": "parameter", "target": "organ.drawbar.1-1-3ft", "mode": "exclusive"},
    {"kind": "parameter", "target": "organ.drawbar.1ft", "mode": "exclusive"},
    {"kind": "parameter", "target": "organ.percussion", "mode": "exclusive"},
    {"kind": "parameter", "target": "organ.key-click", "mode": "exclusive"},
    {"kind": "parameter", "target": "organ.leakage", "mode": "exclusive"},
    {"kind": "parameter", "target": "organ.chorus-vibrato", "mode": "exclusive"},
    {"kind": "parameter", "target": "organ.rotary-speed", "mode": "exclusive"},
    {"kind": "parameter", "target": "organ.drive", "mode": "exclusive"},
    {"kind": "parameter", "target": "organ.microphone-balance", "mode": "exclusive"},
    {"kind": "parameter", "target": "organ.volume", "mode": "exclusive"},
    {"kind": "parameter", "target": "organ.reverb", "mode": "exclusive"}
  ],
  "dependencies": {
    "engines": ["engine.setbfree"],
    "effects": ["effect.arturia.sustain-scale", "effect.master.instrument-mixer"],
    "routes": ["route.arturia.performance-fanout", "route.arturia.controls", "route.master.output"],
    "helpers": ["helper.arturia-main-volume-encoder"],
    "assets": ["asset.setbfree"]
  },
  "switch_safety": {"on_failure": "retain-active", "rollback": "required", "transition": "preserve"}
}
