{
  "schema": "music-studies/performance-rig/v1",
  "kind": "device-profile",
  "id": "synth-programmer-synthv1",
  "display_name": "Synth Programmer Layout (synthv1 Candidate)",
  "description": "S2 candidate Arturia layout using the synthv1 ControlPort engine contract; not included in the protected Airstar binding.",
  "slot": "arturia-main",
  "compatible_models": ["KeyLab Essential 61 mk3"],
  "hardware_preset": "arturia-current-rack",
  "required_endpoints": ["midi.performance-input"],
  "required_capabilities": [
    "notes.layered-instruments",
    "parameter.layer-volume",
    "parameter.layer-reverb",
    "parameter.master-volume",
    "control.master-mute"
  ],
  "readiness": "control-only",
  "takeover_policy": {"default": "ignore-until-moved", "volume": "pickup"},
  "state_policy": "persist",
  "mappings": [
    {"id": "oscillator-mix", "source_control": "fader-1", "target": "synth.oscillator-mix", "transform": {"type": "direct"}, "takeover": "pickup"},
    {"id": "oscillator-2-level", "source_control": "fader-2", "target": "synth.oscillator-2-level", "transform": {"type": "direct"}, "takeover": "pickup"},
    {"id": "filter-cutoff", "source_control": "fader-3", "target": "synth.filter-cutoff", "transform": {"type": "direct"}, "takeover": "pickup"},
    {"id": "filter-resonance", "source_control": "fader-4", "target": "synth.filter-resonance", "transform": {"type": "direct"}, "takeover": "pickup"},
    {"id": "amp-attack", "source_control": "fader-5", "target": "synth.amp-attack", "transform": {"type": "direct"}, "takeover": "pickup"},
    {"id": "amp-release", "source_control": "fader-6", "target": "synth.amp-release", "transform": {"type": "direct"}, "takeover": "pickup"},
    {"id": "modulation-depth", "source_control": "fader-7", "target": "synth.modulation-depth", "transform": {"type": "direct"}, "takeover": "pickup"},
    {"id": "modulation-rate", "source_control": "fader-8", "target": "synth.modulation-rate", "transform": {"type": "direct"}, "takeover": "pickup"},
    {"id": "unison", "source_control": "fader-9", "target": "synth.unison", "transform": {"type": "direct"}, "takeover": "pickup"},
    {"id": "drive", "source_control": "knob-1", "target": "synth.drive", "transform": {"type": "direct"}},
    {"id": "effects-mix", "source_control": "knob-2", "target": "synth.effects-mix", "transform": {"type": "direct"}},
    {"id": "delay-time", "source_control": "knob-3", "target": "synth.delay-time", "transform": {"type": "direct"}},
    {"id": "delay-feedback", "source_control": "knob-4", "target": "synth.delay-feedback", "transform": {"type": "direct"}},
    {"id": "reverb-size", "source_control": "knob-5", "target": "synth.reverb-size", "transform": {"type": "direct"}},
    {"id": "reverb-mix", "source_control": "knob-6", "target": "synth.reverb-mix", "transform": {"type": "direct"}},
    {"id": "pitch-modulation", "source_control": "knob-7", "target": "synth.pitch-modulation", "transform": {"type": "direct"}},
    {"id": "synth-volume", "source_control": "knob-8", "target": "synth.volume", "transform": {"type": "direct"}},
    {"id": "synth-reverb", "source_control": "knob-9", "target": "synth.reverb", "transform": {"type": "direct"}}
  ],
  "ownership": [
    {"kind": "parameter", "target": "synth.oscillator-mix", "mode": "exclusive"},
    {"kind": "parameter", "target": "synth.oscillator-2-level", "mode": "exclusive"},
    {"kind": "parameter", "target": "synth.filter-cutoff", "mode": "exclusive"},
    {"kind": "parameter", "target": "synth.filter-resonance", "mode": "exclusive"},
    {"kind": "parameter", "target": "synth.amp-attack", "mode": "exclusive"},
    {"kind": "parameter", "target": "synth.amp-release", "mode": "exclusive"},
    {"kind": "parameter", "target": "synth.modulation-depth", "mode": "exclusive"},
    {"kind": "parameter", "target": "synth.modulation-rate", "mode": "exclusive"},
    {"kind": "parameter", "target": "synth.unison", "mode": "exclusive"},
    {"kind": "parameter", "target": "synth.drive", "mode": "exclusive"},
    {"kind": "parameter", "target": "synth.effects-mix", "mode": "exclusive"},
    {"kind": "parameter", "target": "synth.delay-time", "mode": "exclusive"},
    {"kind": "parameter", "target": "synth.delay-feedback", "mode": "exclusive"},
    {"kind": "parameter", "target": "synth.reverb-size", "mode": "exclusive"},
    {"kind": "parameter", "target": "synth.reverb-mix", "mode": "exclusive"},
    {"kind": "parameter", "target": "synth.pitch-modulation", "mode": "exclusive"},
    {"kind": "parameter", "target": "synth.volume", "mode": "exclusive"},
    {"kind": "parameter", "target": "synth.reverb", "mode": "exclusive"}
  ],
  "dependencies": {
    "engines": ["engine.synthv1"],
    "effects": ["effect.arturia.sustain-scale", "effect.master.instrument-mixer"],
    "routes": ["route.arturia.performance-fanout", "route.arturia.controls", "route.master.output"],
    "helpers": ["helper.arturia-main-volume-encoder"],
    "assets": ["asset.synthv1"]
  },
  "switch_safety": {"on_failure": "retain-active", "rollback": "required", "transition": "preserve"}
}
