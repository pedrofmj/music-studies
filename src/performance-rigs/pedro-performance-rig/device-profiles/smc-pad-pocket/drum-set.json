{
  "schema": "music-studies/performance-rig/v1",
  "kind": "device-profile",
  "id": "drum-set",
  "display_name": "Drum Set",
  "description": "Current pocket SMC-PAD drum role sharing the loaded drum engine's note destination with the full-size pad controller.",
  "slot": "smc-pad-pocket",
  "compatible_models": [
    "M-VAVE SMC-PAD Pocket"
  ],
  "hardware_preset": "smc-pad-pocket-current-notes",
  "required_endpoints": [
    "midi.performance-input"
  ],
  "required_capabilities": [
    "notes.drum-set"
  ],
  "readiness": "control-only",
  "takeover_policy": {
    "default": "ignore-until-moved",
    "volume": "pickup"
  },
  "state_policy": "follow-engine",
  "mappings": [
    { "id": "drum-notes", "source_control": "performance-pads", "target": "drum-set.notes", "transform": { "type": "direct" } }
  ],
  "ownership": [
    { "kind": "semantic-control", "target": "drum-set.notes", "mode": "shared-event-destination" },
    { "kind": "route", "target": "route.smc-pad-pocket.drum-set", "mode": "exclusive" },
    { "kind": "engine", "target": "engine.drum-set", "mode": "read-only" }
  ],
  "dependencies": {
    "engines": [
      "engine.drum-set"
    ],
    "effects": [
      "effect.pad.sustain-scale",
      "effect.master.instrument-mixer"
    ],
    "routes": [
      "route.smc-pad-pocket.drum-set"
    ],
    "helpers": [],
    "assets": [
      "asset.drum-set.soundfont"
    ]
  },
  "switch_safety": {
    "on_failure": "retain-active",
    "rollback": "required",
    "transition": "preserve"
  }
}
