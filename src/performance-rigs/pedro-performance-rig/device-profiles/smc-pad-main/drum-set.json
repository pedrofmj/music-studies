{
  "schema": "music-studies/performance-rig/v1",
  "kind": "device-profile",
  "id": "drum-set",
  "display_name": "Drum Set",
  "description": "Current full-size SMC-PAD drum role with shared note input, instrument volume, and output gain control.",
  "slot": "smc-pad-main",
  "compatible_models": [
    "M-VAVE SMC-PAD"
  ],
  "hardware_preset": "smc-pad-current-notes",
  "required_endpoints": [
    "midi.performance-input"
  ],
  "required_capabilities": [
    "notes.drum-set",
    "parameter.drum-set-volume",
    "parameter.drum-set-output-gain"
  ],
  "readiness": "control-only",
  "takeover_policy": {
    "default": "ignore-until-moved",
    "volume": "pickup"
  },
  "state_policy": "follow-engine",
  "mappings": [
    { "id": "drum-note-1", "source_control": "performance-pad-1", "target": "drum-set.notes", "transform": { "type": "direct" } },
    { "id": "drum-note-2", "source_control": "performance-pad-2", "target": "drum-set.notes", "transform": { "type": "direct" } },
    { "id": "drum-note-3", "source_control": "performance-pad-3", "target": "drum-set.notes", "transform": { "type": "direct" } },
    { "id": "drum-note-4", "source_control": "performance-pad-4", "target": "drum-set.notes", "transform": { "type": "direct" } },
    { "id": "drum-note-5", "source_control": "performance-pad-5", "target": "drum-set.notes", "transform": { "type": "direct" } },
    { "id": "drum-note-6", "source_control": "performance-pad-6", "target": "drum-set.notes", "transform": { "type": "direct" } },
    { "id": "drum-note-7", "source_control": "performance-pad-7", "target": "drum-set.notes", "transform": { "type": "direct" } },
    { "id": "drum-note-8", "source_control": "performance-pad-8", "target": "drum-set.notes", "transform": { "type": "direct" } },
    { "id": "drum-note-9", "source_control": "performance-pad-9", "target": "drum-set.notes", "transform": { "type": "direct" } },
    { "id": "drum-note-10", "source_control": "performance-pad-10", "target": "drum-set.notes", "transform": { "type": "direct" } },
    { "id": "drum-note-11", "source_control": "performance-pad-11", "target": "drum-set.notes", "transform": { "type": "direct" } },
    { "id": "drum-note-12", "source_control": "performance-pad-12", "target": "drum-set.notes", "transform": { "type": "direct" } },
    { "id": "drum-note-13", "source_control": "performance-pad-13", "target": "drum-set.notes", "transform": { "type": "direct" } },
    { "id": "drum-note-14", "source_control": "performance-pad-14", "target": "drum-set.notes", "transform": { "type": "direct" } },
    { "id": "drum-note-15", "source_control": "performance-pad-15", "target": "drum-set.notes", "transform": { "type": "direct" } },
    { "id": "drum-note-16", "source_control": "performance-pad-16", "target": "drum-set.notes", "transform": { "type": "direct" } },
    { "id": "drum-volume", "source_control": "knob-1", "target": "drum-set.volume", "transform": { "type": "scale", "input_min": 0, "input_max": 127, "output_min": 0, "output_max": 1 }, "takeover": "pickup" },
    { "id": "drum-output-gain", "source_control": "knob-2", "target": "drum-set.output-gain-db", "transform": { "type": "scale", "input_min": 0, "input_max": 127, "output_min": 0, "output_max": 12 }, "takeover": "pickup" }
  ],
  "ownership": [
    { "kind": "semantic-control", "target": "drum-set.notes", "mode": "shared-event-destination" },
    { "kind": "parameter", "target": "drum-set.volume", "mode": "exclusive" },
    { "kind": "parameter", "target": "drum-set.output-gain-db", "mode": "exclusive" },
    { "kind": "route", "target": "route.smc-pad-main.drum-set", "mode": "exclusive" },
    { "kind": "engine", "target": "engine.drum-set", "mode": "read-only" }
  ],
  "dependencies": {
    "engines": [
      "engine.drum-set"
    ],
    "effects": [
      "effect.pad.sustain-scale",
      "effect.pad.output-gain-map",
      "effect.master.instrument-mixer"
    ],
    "routes": [
      "route.smc-pad-main.drum-set",
      "route.smc-pad-main.output-gain"
    ],
    "helpers": [],
    "assets": [
      "asset.drum-set.soundfont"
    ]
  },
  "switch_safety": {
    "on_failure": "retain-active",
    "rollback": "required",
    "transition": "preserve"
  }
}
