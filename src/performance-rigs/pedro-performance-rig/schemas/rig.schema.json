{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.music-studies.dev/performance-rig/v1/rig.schema.json",
  "title": "Performance Rig v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "id",
    "display_name",
    "default_rig_profile",
    "device_slots",
    "rig_profiles",
    "hardware_presets",
    "switch_triggers",
    "required_platforms"
  ],
  "properties": {
    "schema": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "kind": {
      "const": "performance-rig"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "display_name": {
      "$ref": "common.schema.json#/$defs/display_name"
    },
    "description": {
      "$ref": "common.schema.json#/$defs/description"
    },
    "default_rig_profile": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "fallback_rig_profile": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "device_slots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/device_slot"
      }
    },
    "rig_profiles": {
      "$ref": "common.schema.json#/$defs/identifier_array",
      "minItems": 1
    },
    "hardware_presets": {
      "$ref": "common.schema.json#/$defs/identifier_array"
    },
    "switch_triggers": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "required_platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/platform"
      }
    }
  },
  "$defs": {
    "device_slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "compatible_models",
        "required_endpoints",
        "selectors",
        "available_device_profiles"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "display_name": {
          "$ref": "common.schema.json#/$defs/display_name"
        },
        "compatible_models": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required_endpoints": {
          "$ref": "common.schema.json#/$defs/semantic_identifier_array",
          "minItems": 1
        },
        "selectors": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/selector"
          }
        },
        "available_device_profiles": {
          "$ref": "common.schema.json#/$defs/identifier_array",
          "minItems": 1
        },
        "required": {
          "type": "boolean"
        }
      }
    }
  }
}
