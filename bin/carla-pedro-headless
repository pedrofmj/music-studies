#!/usr/bin/env bash
set -euo pipefail

export LANG=C
export LC_ALL=C
export LC_NUMERIC=C

readonly CONFIG_FILE="${CARLA_PEDRO_CONFIG:-${HOME}/.config/pedro-live-rack.conf}"
if [[ -r $CONFIG_FILE ]]; then
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
fi

readonly PROJECT="${CARLA_PEDRO_PROJECT:-/c/music/carla/pedro.uproject}"
readonly SOUNDFONT_WORKDIR="${CARLA_PEDRO_SOUNDFONT_WORKDIR:-${HOME}/.local/share/carla/pedro-soundfonts}"
readonly APP_ID="studio.kx.carla"
readonly OSC_PORT="${CARLA_OSC_UDP_PORT:-21337}"
readonly AUDIO_SINK="alsa_output.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__hw_sofhdadsp__sink"

if [[ ! -r $PROJECT ]]; then
    printf 'Carla project is not readable: %s\n' "$PROJECT" >&2
    exit 1
fi
if [[ ! -d $SOUNDFONT_WORKDIR ]]; then
    printf 'Carla SoundFont directory is missing: %s\n' "$SOUNDFONT_WORKDIR" >&2
    exit 1
fi
if pgrep -f '^/usr/bin/python3 /app/share/carla/carla ' >/dev/null 2>&1; then
    printf '%s\n' 'A Carla process is already running; stop the GUI rack before starting headless Carla.' >&2
    exit 1
fi

flatpak run --cwd="$SOUNDFONT_WORKDIR" --file-forwarding "$APP_ID" \
    --no-gui "--osc-gui=${OSC_PORT}" @@ "$PROJECT" @@ &
launcher_pid=$!

stop() {
    kill "$launcher_pid" >/dev/null 2>&1 || true
    if [[ -n ${link_restore_pid:-} ]]; then
        kill "$link_restore_pid" >/dev/null 2>&1 || true
    fi
    flatpak kill "$APP_ID" >/dev/null 2>&1 || true
    exit 143
}
trap stop TERM INT

for _ in {1..120}; do
    if pgrep -f '^/usr/bin/python3 /app/share/carla/carla ' >/dev/null 2>&1; then
        break
    fi
    if ! kill -0 "$launcher_pid" >/dev/null 2>&1; then
        printf '%s\n' 'Carla launcher exited before the backend registered.' >&2
        exit 1
    fi
    sleep 0.25
done

if ! pgrep -f '^/usr/bin/python3 /app/share/carla/carla ' >/dev/null 2>&1; then
    printf '%s\n' 'Carla backend did not register within 30 seconds.' >&2
    stop
fi

restore_audio_links() {
    for _ in {1..24}; do
        timeout 3s pw-link "SMC-MIX - 8-Band EQ:Output L" \
            "Arturia Main Volume Encoder:audio-in-l" >/dev/null 2>&1 || true
        timeout 3s pw-link "SMC-MIX - 8-Band EQ:Output R" \
            "Arturia Main Volume Encoder:audio-in-r" >/dev/null 2>&1 || true
        timeout 3s pw-link "Arturia Main Volume Encoder:absolute-out" \
            "LSP Mixer x8 Stereo:events-in" >/dev/null 2>&1 || true
        timeout 3s pw-link "Arturia Main Volume Encoder:audio-out-l" \
            "${AUDIO_SINK}:playback_FL" >/dev/null 2>&1 || true
        timeout 3s pw-link "Arturia Main Volume Encoder:audio-out-r" \
            "${AUDIO_SINK}:playback_FR" >/dev/null 2>&1 || true
        sleep 2
    done
}
restore_audio_links &
link_restore_pid=$!

while pgrep -f '^/usr/bin/python3 /app/share/carla/carla ' >/dev/null 2>&1; do
    sleep 1
done

kill "$link_restore_pid" >/dev/null 2>&1 || true
wait "$link_restore_pid" 2>/dev/null || true
printf '%s\n' 'Carla backend exited unexpectedly.' >&2
exit 1
