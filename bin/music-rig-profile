#!/usr/bin/env python3
"""Apply and inspect versioned Music Rig runtime profiles."""

from __future__ import annotations

import argparse
import json
import os
import signal
import shutil
import subprocess
import sys
import tempfile
import time
import xml.etree.ElementTree as ET
from pathlib import Path


HOME = Path.home()
ENV_FILE = HOME / ".config/music-rig/arturia-profile-session.env"
PREVIOUS_ENV_FILE = ENV_FILE.with_suffix(".env.previous")
EVENT_LOG = HOME / ".local/state/music-rig/arturia-profile-session/transition-events.jsonl"
SELECTOR = "music-rig-arturia-profile-session.service"
HEADLESS = "music-rig-pedro-carla-headless.service"
ENCODER = "arturia-main-volume-encoder.service"
SMK = "smk25-pad-layers.service"
AUDIO_OUTPUT_CONFIG = HOME / ".config/echora/performance-rig-audio-output.properties"
AUDIO_OUTPUT_LEFT = "Arturia Main Volume Encoder:audio-out-l"
AUDIO_OUTPUT_RIGHT = "Arturia Main Volume Encoder:audio-out-r"
ARTURIA_KEYLAB_OUTPUT_TOKEN = "KL Essential 61 mk3"
ARTURIA_KEYLAB_OUTPUT_SUFFIX = ":(capture_0) KL Essential 61 mk3 MIDI"
ROUTE_REPAIR_WAIT_SECONDS = 30
ROUTER_START_WAIT_SECONDS = 90
ARTURIA_ROUTER_INPUT = "s2-arturia-profile-router:in"
ARTURIA_ROUTER_OUTPUT = "s2-arturia-profile-router:out"
ARTURIA_MASTER_INPUT = "Arturia Main Volume Encoder:relative-in"
ARTURIA_FULL_RACK_INPUT = "AR Controls - Sustain Scale:events-in"
ARTURIA_NOTE_TARGETS = (
    ARTURIA_FULL_RACK_INPUT,
    "s2-synthv1-live:in",
    "setBfree:midi_in",
)
LIVE_RACK_REQUIRED_PORTS = (
    "AR-CH-1 - Basic Piano:output_1",
    "SMC-MIX - 8-Band EQ:Output L",
    "Arturia Main Volume Encoder:relative-in",
    "Arturia Main Volume Encoder:audio-out-l",
    "Arturia Main Volume Encoder:audio-out-r",
    "AR Controls - Sustain Scale:events-in",
)
SHARED_AUDIO_LINKS = (
    ("SMK Layer Mixer x8 Stereo:Output L", "LSP Mixer x8 Stereo:Input L"),
    ("SMK Layer Mixer x8 Stereo:Output R", "LSP Mixer x8 Stereo:Input R"),
    ("LSP Mixer x8 Stereo:Output L", "SMC-MIX - 8-Band EQ:Input L"),
    ("LSP Mixer x8 Stereo:Output R", "SMC-MIX - 8-Band EQ:Input R"),
    ("SMC-MIX - 8-Band EQ:Output L", "Arturia Main Volume Encoder:audio-in-l"),
    ("SMC-MIX - 8-Band EQ:Output R", "Arturia Main Volume Encoder:audio-in-r"),
    ("Arturia Main Volume Encoder:absolute-out", "LSP Mixer x8 Stereo:events-in"),
)
DEVICE_MIDI_TARGETS = {
    "SMC-Mixer-Master": tuple(f"SMC-EQ-{channel} CC Scale:events-in" for channel in range(1, 9)),
    "SMC-PAD-Master": (
        "PD Controls - Sustain Scale:events-in",
        "PD-CH-1 Gain Map:events-in",
    ),
    "SMC-PAD Pocket-Master": (
        "PD Controls - Sustain Scale:events-in",
        "PD-CH-1 Gain Map:events-in",
    ),
    "SMK25-Master": ("SMK25 Pad Layers:midi-in",),
}


def run(command: list[str], check: bool = False) -> subprocess.CompletedProcess[str]:
    return subprocess.run(command, check=check, text=True, capture_output=True)


def profile_dir() -> Path:
    configured = os.environ.get("MUSIC_RIG_PROFILE_DIR")
    if configured:
        return Path(configured).expanduser()
    local = HOME / ".config/music-rig/profiles"
    if local.is_dir():
        return local
    return Path(__file__).resolve().parent.parent / "docs/tools/music-rig/runtime-profiles"


def profiles() -> dict[str, Path]:
    return {path.stem: path for path in sorted(profile_dir().glob("*.env"))}


def read_env(path: Path = ENV_FILE) -> str:
    return path.read_text(encoding="utf-8") if path.exists() else ""


def write_env(contents: str) -> None:
    ENV_FILE.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=ENV_FILE.parent,
                                    prefix="arturia-profile-session.", delete=False) as stream:
        stream.write(contents)
        temporary = Path(stream.name)
    temporary.replace(ENV_FILE)


def service_state(unit: str) -> str:
    result = run(["systemctl", "--user", "is-active", unit])
    return result.stdout.strip() or "inactive"


def pipewire_links() -> str:
    return run(["pw-link", "-l"]).stdout


def pipewire_output_ports() -> str:
    return run(["pw-link", "-o"]).stdout


def pipewire_input_ports() -> str:
    return run(["pw-link", "-i"]).stdout


def port_present(ports: str, port: str) -> bool:
    return any(line.strip() == port for line in ports.splitlines())


def sleep_for_route_retry(deadline: float) -> None:
    remaining = deadline - time.monotonic()
    if remaining > 0:
        time.sleep(min(1.0, remaining))


def arturia_keylab_output(deadline: float) -> str:
    while True:
        matches = [
            line.strip()
            for line in pipewire_output_ports().splitlines()
            if ARTURIA_KEYLAB_OUTPUT_TOKEN in line.strip()
            and line.strip().endswith(ARTURIA_KEYLAB_OUTPUT_SUFFIX)
        ]
        if matches:
            return matches[0]
        if time.monotonic() >= deadline:
            raise RuntimeError(
                "Arturia KeyLab MIDI output port is not visible; "
                "power on or reconnect the keyboard and wait for PipeWire to expose it."
            )
        sleep_for_route_retry(deadline)


def arturia_note_target(deadline: float) -> str:
    fallback = ""
    while True:
        ports = pipewire_input_ports()
        for target in ARTURIA_NOTE_TARGETS:
            if port_present(ports, target):
                if target == ARTURIA_FULL_RACK_INPUT:
                    return target
                if not fallback:
                    fallback = target
        if time.monotonic() >= deadline:
            if fallback:
                return fallback
            raise RuntimeError(
                "No Arturia router note target is visible; wait for the Performance Rig "
                "to finish starting, or restart the Arturia selector/full rack."
            )
        sleep_for_route_retry(deadline)


def link_present(graph: str, source: str, target: str) -> bool:
    header = ""
    for line in graph.splitlines():
        stripped = line.strip()
        if stripped.startswith("|->"):
            if header == source and stripped[3:].strip() == target:
                return True
        elif stripped.startswith("|<-"):
            if header == target and stripped[3:].strip() == source:
                return True
        elif stripped:
            header = stripped
    return False


def ensure_link(source: str, target: str, deadline: float) -> str:
    last_error = ""
    while True:
        graph = pipewire_links()
        if link_present(graph, source, target):
            return "present"
        result = run(["pw-link", source, target])
        combined = (result.stdout + result.stderr).strip()
        if result.returncode == 0 or "File exists" in combined:
            return "restored"
        last_error = combined
        if time.monotonic() >= deadline:
            raise RuntimeError(f"could not connect {source} -> {target}: {last_error}")
        sleep_for_route_retry(deadline)


def arturia_router_ports_visible() -> bool:
    return (
        port_present(pipewire_input_ports(), ARTURIA_ROUTER_INPUT)
        and port_present(pipewire_output_ports(), ARTURIA_ROUTER_OUTPUT)
    )


def restart_selector() -> None:
    result = run(["systemctl", "--user", "restart", SELECTOR])
    if result.returncode:
        raise RuntimeError(result.stdout or result.stderr or "selector restart failed")


def start_service(unit: str) -> None:
    command = ["systemctl", "--user", "start", unit]
    for attempt in range(3):
        result = run(command)
        if result.returncode == 0:
            return
        error = (result.stdout + result.stderr).strip()
        if attempt == 2 or "Transaction" not in error or "destructive" not in error:
            raise RuntimeError(error or f"could not start {unit}")
        time.sleep(1)


def ensure_arturia_router(deadline: float) -> dict[str, str]:
    keylab = arturia_keylab_output(deadline)
    last_state = service_state(SELECTOR)
    while True:
        if arturia_router_ports_visible():
            return {"keylab": keylab, "selector": service_state(SELECTOR)}
        last_state = service_state(SELECTOR)
        if time.monotonic() >= deadline:
            raise RuntimeError(
                "Arturia profile router ports are not visible; "
                f"selector={last_state}. No service was restarted; inspect the selector before retrying."
            )
        sleep_for_route_retry(deadline)


def repair_routes() -> dict[str, object]:
    router = ensure_arturia_router(time.monotonic() + ROUTER_START_WAIT_SECONDS)
    deadline = time.monotonic() + ROUTE_REPAIR_WAIT_SECONDS
    repaired_links: dict[str, str] = {}
    unresolved: list[str] = []
    repaired_links["router_to_master"] = ensure_link(
        ARTURIA_ROUTER_OUTPUT, ARTURIA_MASTER_INPUT, deadline)
    graph = pipewire_links()
    has_note_target = any(
        link_present(graph, ARTURIA_ROUTER_OUTPUT, target)
        for target in ARTURIA_NOTE_TARGETS
    )
    if has_note_target:
        repaired_links["router_to_note_target"] = "present"
    else:
        target = arturia_note_target(deadline)
        repaired_links["router_to_note_target"] = ensure_link(ARTURIA_ROUTER_OUTPUT, target, deadline)
    repaired_links["keylab_to_router"] = ensure_link(
        arturia_keylab_output(deadline), ARTURIA_ROUTER_INPUT, deadline
    )
    device_sources, missing_sources, missing_targets = wait_for_device_midi_ports(deadline)
    unresolved.extend(f"MIDI source not present: {alias}" for alias in missing_sources)
    unresolved.extend(f"MIDI target not present: {target}" for target in missing_targets)
    for alias, targets in DEVICE_MIDI_TARGETS.items():
        source = device_sources[alias]
        if not source:
            repaired_links[f"device:{alias}"] = "source-not-present"
            continue
        for target in targets:
            if target in missing_targets:
                continue
            try:
                repaired_links[f"{alias}->{target}"] = ensure_link(source, target, deadline)
            except RuntimeError as error:
                unresolved.append(str(error))
    static = repair_project_connections(deadline)
    repaired_links.update(static["links"])
    unresolved.extend(static["unresolved"])
    return {
        "status": "routes-repaired" if not unresolved else "routes-partially-repaired",
        "router": router,
        "links": repaired_links,
        "unresolved_project_links": unresolved,
    }


def wait_for_device_midi_ports(deadline: float) -> tuple[dict[str, str], list[str], list[str]]:
    while True:
        outputs = [line.strip() for line in pipewire_output_ports().splitlines()]
        inputs = set(line.strip() for line in pipewire_input_ports().splitlines())
        sources = {
            alias: next((port for port in outputs if alias in port and "capture_1" in port), "")
            for alias in DEVICE_MIDI_TARGETS
        }
        missing_sources = [alias for alias, source in sources.items() if not source]
        missing_targets = sorted({
            target for targets in DEVICE_MIDI_TARGETS.values()
            for target in targets if target not in inputs
        })
        if (not missing_sources and not missing_targets) or time.monotonic() >= deadline:
            return sources, missing_sources, missing_targets
        sleep_for_route_retry(deadline)


def protected_project_path() -> Path:
    configured = os.environ.get("CARLA_PEDRO_PROJECT")
    config_file = HOME / ".config/pedro-live-rack.conf"
    if not configured and config_file.is_file():
        for line in config_file.read_text(encoding="utf-8").splitlines():
            stripped = line.strip()
            if stripped.startswith("CARLA_PEDRO_PROJECT="):
                configured = stripped.split("=", 1)[1].strip().strip("\"'")
                break
    return Path(configured or "/c/music/carla/pedro.uproject").expanduser()


def repair_project_connections(deadline: float) -> dict[str, object]:
    project = protected_project_path()
    if not project.is_file():
        return {"links": {}, "unresolved": [f"protected project missing: {project}"]}
    try:
        root = ET.parse(project).getroot()
    except (OSError, ET.ParseError) as error:
        return {"links": {}, "unresolved": [f"protected project cannot be parsed: {error}"]}

    outputs = set(line.strip() for line in pipewire_output_ports().splitlines())
    inputs = set(line.strip() for line in pipewire_input_ports().splitlines())
    restored: dict[str, str] = {}
    unresolved: list[str] = []
    for connection in root.findall("./ExternalPatchbay/Connection"):
        source = (connection.findtext("Source") or "").strip()
        target = (connection.findtext("Target") or "").strip()
        if not source or not target:
            continue
        # Device identities and physical sinks are resolved dynamically elsewhere.
        if source.startswith("Midi-Bridge:") or "PipeWire ALSA" in source:
            continue
        if "Speaker + Headphones" in target or "playback_" in target and "PipeWire ALSA" in target:
            continue
        if source not in outputs or target not in inputs:
            unresolved.append(f"{source} -> {target}")
            continue
        try:
            restored[f"{source} -> {target}"] = ensure_link(source, target, deadline)
        except RuntimeError as error:
            unresolved.append(str(error))
    for source, target in SHARED_AUDIO_LINKS:
        if source in outputs and target in inputs:
            try:
                restored[f"{source} -> {target}"] = ensure_link(source, target, deadline)
            except RuntimeError as error:
                unresolved.append(str(error))
    return {"links": restored, "unresolved": unresolved}


def read_properties(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    if not path.exists():
        return values
    for line in path.read_text(encoding="utf-8").splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#") or "=" not in stripped:
            continue
        key, value = stripped.split("=", 1)
        values[key.strip()] = value.strip()
    return values


def discover_audio_sinks() -> dict[str, tuple[str, str]]:
    left: dict[str, str] = {}
    right: dict[str, str] = {}
    for line in pipewire_input_ports().splitlines():
        port = line.strip()
        if port.endswith(":playback_FL"):
            left[port.rsplit(":", 1)[0]] = port
        elif port.endswith(":playback_FR"):
            right[port.rsplit(":", 1)[0]] = port
    return {sink: (left[sink], right[sink]) for sink in left if sink in right}


def audio_repair_targets(sinks: dict[str, tuple[str, str]]) -> list[str]:
    properties = read_properties(AUDIO_OUTPUT_CONFIG)
    mode = properties.get("mode", "DEFAULT")
    if mode == "SINGLE_CUSTOM" and properties.get("singleSink") in sinks:
        return [properties["singleSink"]]
    if mode == "MULTIPLE":
        active = [sink.strip() for sink in properties.get("activeSinks", "").split(",")
                  if sink.strip() in sinks]
        if active:
            return active
    analog = next((sink for sink in sinks if "analog-stereo" in sink), None)
    if analog:
        return [analog]
    return list(sinks)[:1]


def repair_audio_output() -> dict[str, object]:
    deadline = time.monotonic() + ROUTE_REPAIR_WAIT_SECONDS
    sinks: dict[str, tuple[str, str]] = {}
    while time.monotonic() < deadline:
        sinks = discover_audio_sinks()
        if sinks:
            break
        sleep_for_route_retry(deadline)
    if not sinks:
        raise RuntimeError("no controllable audio output sink is visible")
    targets = audio_repair_targets(sinks)
    links: dict[str, str] = {}
    for sink in targets:
        left, right = sinks[sink]
        links[f"{sink}:left"] = ensure_link(AUDIO_OUTPUT_LEFT, left, deadline)
        links[f"{sink}:right"] = ensure_link(AUDIO_OUTPUT_RIGHT, right, deadline)
        if sink.startswith("alsa_output.") and "analog-stereo" in sink:
            run(["pactl", "set-sink-port", sink, "analog-output-headphones"])
    return {"status": "audio-repaired", "sinks": targets, "links": links}


def wait_for_live_rack(timeout: float = 90) -> None:
    deadline = time.monotonic() + timeout
    missing = list(LIVE_RACK_REQUIRED_PORTS)
    while time.monotonic() < deadline:
        ports = set(line.strip() for line in (pipewire_output_ports() + pipewire_input_ports()).splitlines())
        missing = [port for port in LIVE_RACK_REQUIRED_PORTS if port not in ports]
        if not missing:
            return
        time.sleep(1)
    raise RuntimeError("live rack ports did not register: " + ", ".join(missing))


def recover_live_rig() -> dict[str, object]:
    # Recovery is additive: do not restart a healthy audio engine or clear pad state.
    arturia_keylab_output(time.monotonic() + ROUTER_START_WAIT_SECONDS)
    for unit in (HEADLESS, ENCODER, SMK, SELECTOR):
        if service_state(unit) not in {"active", "activating"}:
            start_service(unit)
    wait_for_live_rack()
    ensure_arturia_router(time.monotonic() + ROUTER_START_WAIT_SECONDS)
    audio = repair_audio_output()
    routes = repair_routes()
    fully_recovered = routes["status"] == "routes-repaired"
    return {
        "status": "rig-recovered" if fully_recovered else "rig-partially-recovered",
        "disruptive_service_restarts": [],
        "audio": audio,
        "routes": routes,
    }


def latest_events(limit: int = 12) -> list[dict[str, object]]:
    if not EVENT_LOG.exists():
        return []
    entries: list[dict[str, object]] = []
    for line in EVENT_LOG.read_text(encoding="utf-8").splitlines()[-limit:]:
        try:
            entries.append(json.loads(line))
        except json.JSONDecodeError:
            entries.append({"raw": line})
    return entries


def status() -> dict[str, object]:
    return {
        "profile_dir": str(profile_dir()),
        "environment_file": str(ENV_FILE),
        "environment": read_env().splitlines(),
        "services": {
            "headless": service_state(HEADLESS),
            "encoder": service_state(ENCODER),
            "selector": service_state(SELECTOR),
            "smk25": service_state(SMK),
        },
        "events": latest_events(),
    }


def apply_profile(name: str) -> None:
    available = profiles()
    if name not in available:
        raise RuntimeError(f"unknown profile {name!r}; available: {', '.join(sorted(available))}")
    previous = read_env()
    if previous:
        PREVIOUS_ENV_FILE.write_text(previous, encoding="utf-8")
    contents = available[name].read_text(encoding="utf-8")
    expected_genres = next(
        (line.split("=", 1)[1].strip().split(",")
         for line in contents.splitlines()
         if line.startswith("MUSIC_RIG_FAST_GENRES=")),
        [],
    )
    write_env(contents)
    restart_selector()
    deadline = time.monotonic() + 90
    while time.monotonic() < deadline:
        if service_state(SELECTOR) == "active":
            events = latest_events(3)
            warm_events = [event for event in events
                           if event.get("event") == "fast-mode-enabled"]
            if expected_genres:
                if any(set(event.get("warm_genres", [])) == set(expected_genres)
                       for event in warm_events):
                    return
            elif warm_events:
                return
        time.sleep(1)
    if previous:
        write_env(previous)
        restart_selector()
    raise RuntimeError(f"profile {name!r} did not become ready; previous profile restored")


def rollback() -> None:
    if not PREVIOUS_ENV_FILE.exists():
        raise RuntimeError("no previous profile is available")
    current = read_env()
    ENV_FILE.write_text(PREVIOUS_ENV_FILE.read_text(encoding="utf-8"), encoding="utf-8")
    PREVIOUS_ENV_FILE.write_text(current, encoding="utf-8")
    restart_selector()


def wait_for_ports(names: list[str], timeout: float = 90) -> None:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        outputs = run(["pw-link", "-o"]).stdout.splitlines()
        if all(name in outputs for name in names):
            return
        time.sleep(1)
    raise RuntimeError(f"required Carla ports did not register: {', '.join(names)}")


def kill_orphan_genres() -> None:
    result = run(["ps", "-eo", "pid=,args="])
    pids: list[int] = []
    for line in result.stdout.splitlines():
        parts = line.strip().split(None, 1)
        if len(parts) != 2 or not any(prefix in parts[1]
                                      for prefix in ("FAST-GENRE-", "SAFE-GENRE-")):
            continue
        try:
            pids.append(int(parts[0]))
        except ValueError:
            pass
    for pid in pids:
        try:
            os.kill(pid, signal.SIGTERM)
        except (ProcessLookupError, PermissionError):
            pass
    if pids:
        time.sleep(3)
    for pid in pids:
        try:
            os.kill(pid, signal.SIGKILL)
        except (ProcessLookupError, PermissionError):
            pass
    run(["flatpak", "kill", "studio.kx.carla"])


def emergency_reset() -> Path:
    timestamp = time.strftime("%Y%m%dT%H%M%S")
    backup = HOME / ".local/state/music-rig/emergency-resets" / timestamp
    backup.mkdir(parents=True, exist_ok=True)
    for source in (ENV_FILE, PREVIOUS_ENV_FILE,
                   HOME / ".local/state/smk25-pad-layers/state",
                   HOME / ".local/share/music-rig/arturia-profile-session/last-session.json"):
        if source.exists():
            shutil.copy2(source, backup / source.name)
    write_env("MUSIC_RIG_TRANSITION_MODE=fast\n")
    for unit in (SELECTOR, ENCODER, SMK, HEADLESS):
        run(["systemctl", "--user", "stop", unit])
    kill_orphan_genres()
    state = HOME / ".local/state/smk25-pad-layers/state"
    if state.exists():
        state.unlink()
    run(["systemctl", "--user", "start", HEADLESS], check=True)
    wait_for_ports(["AR-CH-1 - Basic Piano:output_1", "SMC-MIX - 8-Band EQ:Output L"])
    run(["systemctl", "--user", "start", ENCODER], check=True)
    run(["systemctl", "--user", "start", SMK], check=True)
    run(["systemctl", "--user", "start", SELECTOR], check=True)
    return backup


def reset(kind: str) -> str | None:
    if kind == "genres":
        write_env("MUSIC_RIG_TRANSITION_MODE=fast\n")
        restart_selector()
        return None
    if kind == "arturia":
        restart_selector()
        return None
    if kind == "smk25":
        run(["systemctl", "--user", "stop", SMK], check=True)
        state = HOME / ".local/state/smk25-pad-layers/state"
        if state.exists():
            state.replace(state.with_name("state.reset-backup"))
        run(["systemctl", "--user", "start", SMK], check=True)
        return None
    if kind == "output":
        run(["systemctl", "--user", "restart", ENCODER], check=True)
        return None
    if kind == "full":
        write_env("MUSIC_RIG_TRANSITION_MODE=fast\n")
        run(["systemctl", "--user", "stop", SELECTOR], check=True)
        run(["systemctl", "--user", "restart", HEADLESS], check=True)
        run(["systemctl", "--user", "restart", ENCODER], check=True)
        run(["systemctl", "--user", "start", SELECTOR], check=True)
        return None
    if kind == "emergency":
        return str(emergency_reset())
    raise RuntimeError(f"unknown reset type: {kind}")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="operation", required=True)
    subparsers.add_parser("status")
    subparsers.add_parser("list")
    apply_parser = subparsers.add_parser("apply")
    apply_parser.add_argument("profile")
    subparsers.add_parser("rollback")
    subparsers.add_parser("repair-routes")
    subparsers.add_parser("repair-audio")
    subparsers.add_parser("recover")
    events_parser = subparsers.add_parser("events")
    events_parser.add_argument("--limit", type=int, default=20)
    reset_parser = subparsers.add_parser("reset")
    reset_parser.add_argument("kind", choices=(
        "full", "emergency", "arturia", "smk25", "output", "genres"))
    arguments = parser.parse_args()
    try:
        if arguments.operation == "status":
            print(json.dumps(status(), indent=2, sort_keys=True))
        elif arguments.operation == "list":
            print("\n".join(sorted(profiles())))
        elif arguments.operation == "apply":
            apply_profile(arguments.profile)
            print(json.dumps(status(), indent=2, sort_keys=True))
        elif arguments.operation == "rollback":
            rollback()
            print(json.dumps(status(), indent=2, sort_keys=True))
        elif arguments.operation == "repair-routes":
            result = repair_routes()
            print(json.dumps(result, indent=2, sort_keys=True))
            return 0 if result["status"] == "routes-repaired" else 1
        elif arguments.operation == "repair-audio":
            print(json.dumps(repair_audio_output(), indent=2, sort_keys=True))
        elif arguments.operation == "recover":
            result = recover_live_rig()
            print(json.dumps(result, indent=2, sort_keys=True))
            return 0 if result["status"] == "rig-recovered" else 1
        elif arguments.operation == "events":
            print(json.dumps(latest_events(arguments.limit), indent=2, sort_keys=True))
        elif arguments.operation == "reset":
            backup = reset(arguments.kind)
            payload = status()
            if backup:
                payload["emergency_backup"] = backup
            print(json.dumps(payload, indent=2, sort_keys=True))
        return 0
    except (OSError, RuntimeError, subprocess.CalledProcessError) as error:
        print(json.dumps({"error": str(error)}), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
